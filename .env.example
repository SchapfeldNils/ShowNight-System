PUBLIC_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://shownight:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:55432/shownight
# 64 hex characters (32 random bytes), generated by local:setup; retain with backup
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MEDIA_ROOT=.local/media
MAX_UPLOAD_BYTES=104857600
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MAIL_DELIVERY_ENABLED=false
MAIL_MODE=test
DEMO_ENABLED=true
# Empty means do not trust forwarded headers. Production: exact proxy IP/CIDR.
TRUSTED_PROXY_CIDRS=
