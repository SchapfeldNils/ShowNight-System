# Copy outside the public repo. Generate both secrets (64 hex characters).
STACK_NAME=shownight
SHOWNIGHT_IMAGE=shownight:REPLACE_WITH_COMMIT_SHA
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
PUBLIC_BASE_URL=https://eventmanagement.jungschuetzen-flueren.de
PROXY_NETWORK_NAME=REPLACE_WITH_EXISTING_PROXY_NETWORK
PROXY_APP_ALIAS=shownight-app
# Exact existing Nginx IP/CIDR; empty rejects forwarded headers.
TRUSTED_PROXY_CIDRS=
DB_VOLUME_NAME=shownight-database
MEDIA_VOLUME_NAME=shownight-media
MAX_UPLOAD_BYTES=104857600
DEMO_ENABLED=false
MAIL_DELIVERY_ENABLED=false
MAIL_MODE=test
# Actual mailbox values, TLS mode implicit or starttls; no provider guesses.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_TLS_MODE=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_REPLY_TO=
