# For the verified existing Nginx Proxy Manager 2.13.6:
# Proxy Host -> Advanced, only for eventmanagement.jungschuetzen-flueren.de.
# NPM recognizes this explicit root location and omits its default root block.
# Keep certificate/SSL management in NPM. Do not paste the generic http map here.
location / {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $shownight_upstream shownight-app:3000;
    proxy_pass http://$shownight_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
    client_max_body_size 101m;
    proxy_connect_timeout 10s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_request_buffering off;
    proxy_buffering off;
}
